diff --git a/yabause/src/libretro/Makefile b/yabause/src/libretro/Makefile
index 7752e8278..8bc0df312 100644
--- a/yabause/src/libretro/Makefile
+++ b/yabause/src/libretro/Makefile
@@ -281,6 +281,27 @@ else ifeq ($(platform), miyoomini)
 	DYNAREC = 3
 	ARCH_IS_LINUX = 1
 	
+# NextUI: TrimUI Smart Pro / Brick (tg5040), TrimUI Smart Pro S (tg5050),
+# Anbernic RG XX H700 (h700). AArch64; there is no AArch64 dynarec, so the
+# SH-2s run on the interpreter.
+else ifneq (,$(filter $(platform),tg5040 tg5050 h700))
+	TARGET := $(TARGET_NAME)_libretro.so
+	fpic := -fPIC
+	SHARED := -shared -Wl,--no-undefined -Wl,--version-script=link.T
+	CC = $(CROSS_COMPILE)gcc
+	CXX = $(CROSS_COMPILE)g++
+	CC_AS = $(CROSS_COMPILE)gcc
+	AR = $(CROSS_COMPILE)ar
+	FLAGS += -pthread -fomit-frame-pointer -ffast-math -DARM
+	ifeq ($(platform), tg5050)
+		FLAGS += -mcpu=cortex-a55 -mtune=cortex-a55
+	else
+		FLAGS += -mcpu=cortex-a53 -mtune=cortex-a53
+	endif
+	LDFLAGS += -pthread
+	HAVE_SSE = 0
+	ARCH_IS_LINUX = 1
+
 # (armv8 a35, hard point, neon based) ###
 # Playstation Classic
 else ifeq ($(platform), classic_armv8_a35)
